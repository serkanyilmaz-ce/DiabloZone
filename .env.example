# Never commit real credentials. Forum/Supabase is deferred.
DATABASE_URL=postgresql://diablozone_writer:CHANGE_ME@127.0.0.1:5432/diablozone
DATABASE_READ_URL=postgresql://diablozone_reader:CHANGE_ME@127.0.0.1:5432/diablozone
DATA_SEASON=15
# Explicitly choose live or ptr before importing. Empty prevents accidental import.
DATA_CHANNEL=
API_HOST=127.0.0.1
API_PORT=8787
# Keep disabled for direct access. Enable only for the supplied same-host Caddy proxy.
API_TRUST_LOOPBACK_PROXY=0
# Optional allowed frontend origin; keep empty for same-origin reverse proxy.
API_ALLOWED_ORIGIN=
SITE_URL=http://localhost:4321
BASE_PATH=/
