# /etc/diablozone/api.env; root-owned 0600. Contains the reader URL only.
DATABASE_READ_URL=postgresql://diablozone_reader:CHANGE_ME@127.0.0.1:5432/diablozone
API_HOST=127.0.0.1
API_PORT=8787
# Enable only with the supplied same-host Caddy proxy, which overwrites X-Real-IP.
API_TRUST_LOOPBACK_PROXY=1
API_ALLOWED_ORIGIN=
