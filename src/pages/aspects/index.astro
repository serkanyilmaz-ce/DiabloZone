---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DataBrowser from '../../components/DataBrowser.astro';
import DataEmpty from '../../components/DataEmpty.astro';
import {aspects} from '../../lib/data';
import { term } from '../../lib/terms';
const base = import.meta.env.BASE_URL;
const categories = [...new Set(aspects.map(aspect => aspect.category))].sort();
---
<BaseLayout title="Aspektler">
  <div class="breadcrumbs"><a href={base}>Ana sayfa</a><span>/</span><span>Veritabanı</span><span>/</span><span>Aspektler</span></div>
  <section class="page-heading"><p class="eyebrow">EFSANEVİ GÜÇLER</p><h1>Aspektler</h1><p>Build’ini şekillendiren etkiler. Koşulları, sınıf uyumlarını ve ham açıklamaları keşfet.</p></section>
  <form class="toolbar" role="search"><label class="field search-field">Arama<input class="search" type="search" placeholder="Aspekt adı, etki veya etiket…" data-search /></label><label class="field">Kategori<select class="select" data-filter="category"><option value="">Tüm kategoriler</option>{categories.map(c => <option value={c}>{term(c)}</option>)}</select></label></form>
  <DataBrowser count={aspects.length}>
    <div class="card-grid" data-list tabindex="-1">{aspects.map(aspect => <a class="data-card" href={`${base}aspects/${aspect.slug}/`} data-entry data-category={aspect.category} data-searchtext={`${aspect.name} ${aspect.description ?? ''} ${aspect.category} ${term(aspect.category)} ${aspect.classes.map(term).join(' ')} ${aspect.tags.join(' ')}`}><div class="card-main">{aspect.icon ? <div class="aspect-icon-frame"><img class="aspect-icon" src={`${base}${aspect.icon}`} alt="" loading="lazy" /></div> : <span class="entity-fallback" aria-hidden="true">⬡</span>}<div class="card-copy"><div class="card-kicker">{term(aspect.category)}</div><h2>{aspect.name}</h2></div></div><p>{aspect.description ?? 'Kaynakta açıklama bulunmuyor.'}</p><div class="chip-row">{aspect.classes.slice(0,4).map(cls => <span class="chip">{term(cls)}</span>)}</div></a>)}</div>
    {aspects.length === 0 && <DataEmpty kind="aspekt" />}
  </DataBrowser>
</BaseLayout>
