---
import BaseLayout from '../../layouts/BaseLayout.astro';
import aspects from '../../../data/generated/aspects.json';
export function getStaticPaths(){return aspects.map((aspect:any)=>({params:{slug:aspect.slug},props:{aspect}}));}
const {aspect}=Astro.props as any;
const base=import.meta.env.BASE_URL;
---
<BaseLayout title={aspect.name} description={aspect.description??`${aspect.name} aspect details`}>
  <a class="back-link" href={`${base}aspects/`}>← Back to aspects</a>
  <article class="detail-card">
    <div class="detail-heading">
      {aspect.icon && <div class="aspect-detail-frame"><img class="aspect-detail-icon" src={`${base}${aspect.icon}`} alt="" /></div>}
      <div><div class="card-kicker">{aspect.category}</div><h1>{aspect.name}</h1></div>
    </div>
    <p class="lead">{aspect.description??'No description available.'}</p>
    <dl class="detail-grid"><div><dt>Patch</dt><dd>{aspect.patch}</dd></div><div><dt>Aspect SNO</dt><dd>{aspect.source?.sno??'—'}</dd></div><div><dt>Affix SNO</dt><dd>{aspect.affixSource?.sno??'—'}</dd></div><div><dt>Localization SNO</dt><dd>{aspect.localizationSource?.sno??'—'}</dd></div></dl>
    {(aspect.classes?.length??0)>0&&<section class="detail-section"><h2>Classes</h2><div class="chip-row">{aspect.classes.map((c:string)=><span class="chip">{c}</span>)}</div></section>}
    {(aspect.tags?.length??0)>0&&<section class="detail-section"><h2>Tags</h2><div class="chip-row">{aspect.tags.map((t:string)=><span class="chip">{t}</span>)}</div></section>}
    {aspect.descriptionTemplate&&<section class="detail-section"><h2>Raw tooltip template</h2><pre>{aspect.descriptionTemplate}</pre></section>}
  </article>
  <style>.detail-heading{display:flex;align-items:center;gap:26px}.detail-heading h1{margin-bottom:8px}.aspect-detail-frame{width:118px;height:118px;display:grid;place-items:center;flex:0 0 auto;border:1px solid var(--line-strong);background:radial-gradient(circle,var(--surface-3),var(--icon-bg) 72%);box-shadow:inset 0 0 28px color-mix(in srgb,var(--gold) 10%,transparent),0 16px 36px var(--shadow-soft)}.aspect-detail-icon{display:block;max-width:108px;max-height:108px;object-fit:contain}@media(max-width:560px){.detail-heading{align-items:flex-start;gap:16px}.aspect-detail-frame{width:82px;height:82px}.aspect-detail-icon{max-width:74px;max-height:74px}}</style>
</BaseLayout>
