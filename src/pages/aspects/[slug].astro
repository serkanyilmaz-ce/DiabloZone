---
import SourceDetails from '../../components/SourceDetails.astro';
import { term } from '../../lib/terms';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { aspects,affixes } from '../../lib/data';
export function getStaticPaths(){return aspects.map((aspect:any)=>({params:{slug:aspect.slug},props:{aspect}}));}
const {aspect}=Astro.props as any;
const base=import.meta.env.BASE_URL;
---
<BaseLayout title={aspect.name} description={aspect.description??`${aspect.name} aspekt ayrıntıları`}>
  <a class="back-link" href={`${base}aspects/`}>← Aspektlere dön</a>
  <article class="detail-card">
    <div class="detail-heading">
      {aspect.icon && <div class="aspect-detail-frame"><img class="aspect-detail-icon" src={`${base}${aspect.icon}`} alt="" /></div>}
      <div><div class="card-kicker">{term(aspect.category)}</div><h1 data-game-key={`aspects:${aspect.id}`} data-game-field="name" data-name-style="aspect">{aspect.name}</h1></div>
    </div>
    <p class="lead" data-game-key={`aspects:${aspect.id}`} data-game-field="description">{aspect.description??'Kaynakta açıklama bulunmuyor.'}</p><p class="game-values-note">Hesaplanmamış değerler X ile gösterilir. Ham formüller kaynak ayrıntılarında korunur.</p>
    <dl class="detail-grid"><div><dt>Kaynak sürüm</dt><dd>{aspect.patch}</dd></div><div><dt>Aspect SNO</dt><dd>{aspect.source?.sno??'—'}</dd></div><div><dt>Affix SNO</dt><dd>{aspect.affixSource?.sno??'—'}</dd></div><div><dt>Yerelleştirme SNO</dt><dd>{aspect.localizationSource?.sno??'—'}</dd></div></dl>
    {(aspect.classes?.length??0)>0&&<section class="detail-section"><h2>Sınıflar</h2><div class="chip-row">{aspect.classes.map((c:string)=><span class="chip">{term(c)}</span>)}</div></section>}
    {(aspect.tags?.length??0)>0&&<section class="detail-section"><h2>Etiketler</h2><div class="chip-row">{aspect.tags.map((t:string)=><span class="chip">{t}</span>)}</div></section>}
    <section class="detail-section"><h2>İlişkili özellik</h2>{affixes.filter(affix=>affix.id===aspect.affixId).map(affix=><a class="text-link" href={`${base}affixes/${affix.slug}/`}>{affix.name??affix.internalName} →</a>)}</section>
    <SourceDetails source={aspect.source} localizationSource={aspect.localizationSource} patch={aspect.patch} template={aspect.descriptionTemplate} formulas={aspect.rawFormulas} />
  </article>
  <style>.detail-heading{display:flex;align-items:center;gap:26px}.detail-heading h1{margin-bottom:8px}.aspect-detail-frame{width:118px;height:118px;display:grid;place-items:center;flex:0 0 auto;border:1px solid var(--line-strong);background:radial-gradient(circle,var(--surface-3),var(--icon-bg) 72%);box-shadow:inset 0 0 28px color-mix(in srgb,var(--gold) 10%,transparent),0 16px 36px var(--shadow-soft)}.aspect-detail-icon{display:block;max-width:108px;max-height:108px;object-fit:contain}@media(max-width:560px){.detail-heading{align-items:flex-start;gap:16px}.aspect-detail-frame{width:82px;height:82px}.aspect-detail-icon{max-width:74px;max-height:74px}}</style>
</BaseLayout>
