---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArchiveList from '../../components/ArchiveList.astro';
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Affix arşivi">
<div class="breadcrumbs"><a href={base}>Ana sayfa</a><span>/</span><span>Veritabanı</span><span>/</span><span>Affix</span></div>
<section class="page-heading"><p class="eyebrow">ÖZELLİKLERİN ARKASINDA</p><h1>Affix arşivi</h1><p>Eşya özellikleri, ham roll ifadeleri, havuz ağırlıkları ve bağlı güçler. Ağırlık, nihai düşme olasılığı değildir.</p></section>
<ArchiveList kind="affixes" placeholder="Affix adı, nitelik veya etiket…"><Fragment slot="filters"><label class="field"><span>Adlandırma</span><select class="select" data-filter="localized"><option value="">Tüm kaynak kayıtları</option><option value="resolved">Yerelleştirilmiş adı var</option><option value="missing">Kaynak adı</option></select></label></Fragment></ArchiveList>
</BaseLayout>
