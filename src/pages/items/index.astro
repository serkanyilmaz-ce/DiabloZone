---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DataBrowser from '../../components/DataBrowser.astro';
import DataEmpty from '../../components/DataEmpty.astro';
import {items} from '../../lib/data';
import { term } from '../../lib/terms';
const base = import.meta.env.BASE_URL;
const rarities = [...new Set(items.map(item => item.rarity))].sort();
const slots = [...new Set(items.map(item => item.slot).filter((slot): slot is string => !!slot))].sort();
---
<BaseLayout title="Eşyalar">
  <div class="breadcrumbs"><a href={base}>Ana sayfa</a><span>/</span><span>Veritabanı</span><span>/</span><span>Eşyalar</span></div>
  <section class="page-heading"><p class="eyebrow">SANCTUARY’NİN HAZİNELERİ</p><h1>Eşyalar</h1><p>Benzersiz güçler, eşya özellikleri ve sınıf uyumları. Her parçanın arkasındaki veriyi incele.</p></section>
  <form class="toolbar" role="search"><label class="field search-field">Arama<input class="search" type="search" placeholder="Eşya adı, özellik veya sınıf…" data-search /></label><label class="field">Nadirlik<select class="select" data-filter="rarity"><option value="">Tüm nadirlikler</option>{rarities.map(r => <option value={r}>{term(r)}</option>)}</select></label><label class="field">Ekipman yuvası<select class="select" data-filter="slot"><option value="">Tüm yuvalar</option>{slots.map(s => <option value={s}>{term(s)}</option>)}</select></label></form>
  <DataBrowser count={items.length}>
    <div class="card-grid" data-list tabindex="-1">{items.map(item => <a class="data-card" href={`${base}items/${item.slug}/`} data-entry data-rarity={item.rarity} data-slot={item.slot ?? ''} data-searchtext={`${item.name} ${item.flavor ?? ''} ${term(item.rarity)} ${item.rarity} ${term(item.slot)} ${item.classes.map(term).join(' ')}`}><div class="card-main">{item.icon ? <div class="item-icon-frame"><img src={`${base}${item.icon}`} alt="" loading="lazy" /></div> : <span class="entity-fallback" aria-hidden="true">◇</span>}<div class="card-copy"><div class="card-kicker">{term(item.rarity)} · {term(item.slot)}</div><h2>{item.name}</h2></div></div><p>{item.flavor ?? `${item.affixIds.length} özellik referansı · Detaylarda incele.`}</p><div class="chip-row">{item.classes.slice(0,4).map(cls => <span class="chip">{term(cls)}</span>)}</div></a>)}</div>
    {items.length === 0 && <DataEmpty kind="eşya" />}
  </DataBrowser>
</BaseLayout>
