---
import SourceDetails from '../../components/SourceDetails.astro';
import { term } from '../../lib/terms';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { items } from '../../lib/data';
import { affixes } from '../../lib/data';
export function getStaticPaths(){ return items.map((item:any)=>({params:{slug:item.slug},props:{item}})); }
const { item } = Astro.props as any;
const base = import.meta.env.BASE_URL;
const resolvedÖzellikler=(item.affixIds??[]).map((id:string)=>affixes.find((a:any)=>a.id===id)).filter(Boolean);
---
<BaseLayout title={item.name} description={`${item.name} ${term(item.rarity)} ${term(item.slot)}`}>
  <a class="back-link" href={`${base}items/`}>← Eşyalara dön</a>
  <article class="detail-card">
    <div class="detail-heading">
      {item.icon && <div class="item-detail-frame"><img class="detail-icon item-detail-icon" src={`${base}${item.icon}`} alt="" /></div>}
      <div><div class="card-kicker">{term(item.rarity)} · {term(item.slot)}</div><h1>{item.name}</h1></div>
    </div>
    {item.flavor && <blockquote>{item.flavor}</blockquote>}
    <dl class="detail-grid"><div><dt>Gerekli seviye</dt><dd>{item.requiredLevel ?? '—'}</dd></div><div><dt>Eşya gücü</dt><dd>{item.fixedPowerLevel ?? '—'}</dd></div><div><dt>Kaynak sürüm</dt><dd>{item.patch}</dd></div><div><dt>Kaynak SNO</dt><dd>{item.source?.sno ?? '—'}</dd></div></dl>
    <section class="detail-section"><h2>Sınıf uygunluğu</h2>{item.classes.length?<div class="chip-row">{item.classes.map((c:string)=><span class="chip">{term(c)}</span>)}</div>:<p>Kaynak sınıf dizisinin index sırası henüz doğrulanmadı.</p>}</section>
    <section class="detail-section"><h2>Özellikler</h2>{resolvedÖzellikler.length ? <div class="stack">{resolvedÖzellikler.map((a:any)=><div class="affix-row"><strong><a href={`${base}affixes/${a.slug}/`}>{a.name ?? a.internalName} →</a></strong><span>{a.description ?? a.descriptionTemplate ?? 'Yerelleştirilmiş açıklama yok; detaylarda ham ifadeleri incele.'}</span>{(a.staticValues?.length??0)>0 && <code>Statik değer: {a.staticValues.join(', ')}</code>}</div>)}</div> : <p>Çözümlenmiş özellik verisi yok.</p>}</section>
    <SourceDetails source={item.source} localizationSource={item.localizationSource} patch={item.patch} formulas={item.rawFormulas} />
  </article>
  <style>
    .detail-heading{display:flex;align-items:center;gap:28px}.detail-heading h1{margin-bottom:8px}.item-detail-frame{width:150px;height:150px;display:grid;place-items:center;flex:0 0 auto;border:1px solid #5a3b2f;background:radial-gradient(circle,#271811,#0a0605 72%);box-shadow:inset 0 0 32px rgba(168,131,82,.1),0 18px 42px rgba(0,0,0,.28)}.item-detail-icon{display:block;max-width:138px;max-height:138px;object-fit:contain}@media(max-width:560px){.detail-heading{align-items:flex-start;gap:16px}.item-detail-frame{width:100px;height:100px}.item-detail-icon{max-width:92px;max-height:92px}}
  </style>
</BaseLayout>
