---
import SourceDetails from '../../components/SourceDetails.astro';
import Icon from '../../components/Icon.astro';
import { term } from '../../lib/terms';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { items } from '../../lib/data';
import {itemProperties} from '../../lib/item-properties';
import {fallbackIcon,labelSegments} from '../../lib/presentation';
export function getStaticPaths(){ return items.map((item:any)=>({params:{slug:item.slug},props:{item}})); }
const { item } = Astro.props as any;
const base = import.meta.env.BASE_URL;
const {lines,unresolved}=itemProperties([...(item.inherentAffixIds??[]),...item.affixIds]);
const allClasses=item.classes.length>=8;
---
<BaseLayout title={item.name} description={`${item.name} ${term(item.rarity)} ${term(item.slot)}`}>
  <a class="back-link" href={`${base}items/`}>← Eşyalara dön</a>
  <article class:list={['detail-card','data-card-detail',`rarity-${item.rarity}`]} style={item.rarity!=='unknown'?`--rarity:var(--rarity-${item.rarity})`:undefined}>
    <div class="item-tooltip">
      <span class="card-icon">{item.icon?<img class="entity-icon" src={`${base}${item.icon}`} alt="" />:<span class="entity-fallback" title="Özgün ikon henüz bulunamadı"><Icon name={fallbackIcon('items',item.slot)} size={48}/></span>}</span>
      <div>
        <div class="card-kicker" style="color:var(--rarity)">{term(item.rarity)} · {term(item.slot)}</div>
        <h1 data-game-key={`items:${item.id}`} data-game-field="name">{item.name}</h1>
        <div class="chip-row">{item.requiredLevel!==undefined&&<span class="chip">Seviye {item.requiredLevel}</span>}{item.fixedPowerLevel!==undefined&&<span class="chip">Eşya gücü {item.fixedPowerLevel}</span>}<span class="chip">{allClasses?'Tüm sınıflar':item.classes.length?item.classes.map(term).join(' · '):'Sınıf uygunluğu çözülmedi'}</span></div>
        {lines.length>0?<ul class="item-props">{lines.map(line=>line.kind==='power'
          ?<li class="prop-power" data-game-key={`affixes:${line.affixId}`} data-game-field="description">{line.en}</li>
          :<li class="prop-stat" data-no-i18n>{([['en',line.en],['tr',line.tr??line.en]] as const).map(([locale,text])=><span data-locale-only={locale}>{labelSegments(text).map(s=>s.value?<span class="value-token">{s.text}</span>:s.text)}</span>)}</li>)}</ul>
          :<p class="source-note">Kaynakta okunabilir özellik metni yok.</p>}
        {lines.length>0&&<p class="source-note">X: değer eşya gücüne, kademeye veya roll aralığına göre değişir.</p>}
      </div>
    </div>
    {item.flavor && <blockquote data-game-key={`items:${item.id}`} data-game-field="flavor">{item.flavor}</blockquote>}
    <section class="detail-section"><h2>Özellik kayıtları</h2>
      <div class="chip-row">{[...(item.inherentAffixIds??[]),...item.affixIds].map((id:string)=>{const line=lines.find(l=>l.affixId===id);return line?.slug?<a class="chip" href={`${base}affixes/${line.slug}/`}>{line.kind==='power'?'Benzersiz güç':'Özellik'} · {id}</a>:<span class="chip">{id}</span>;})}</div>
      {unresolved>0&&<p class="source-note">{unresolved} özelliğin okunabilir metni kaynakta yok; ham kaydı affix sayfasında incelenebilir.</p>}
    </section>
    <dl class="detail-grid"><div><dt>Gerekli seviye</dt><dd>{item.requiredLevel ?? '—'}</dd></div><div><dt>Eşya gücü</dt><dd>{item.fixedPowerLevel ?? '—'}</dd></div><div><dt>Kaynak sürüm</dt><dd>{item.patch}</dd></div><div><dt>Kaynak SNO</dt><dd>{item.source?.sno ?? '—'}</dd></div></dl>
    <SourceDetails source={item.source} localizationSource={item.localizationSource} patch={item.patch} formulas={item.rawFormulas} />
  </article>
</BaseLayout>
