---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SourceDetails from '../../components/SourceDetails.astro';
import { gameClasses,skills,tree } from '../../lib/data';
import DataBrowser from '../../components/DataBrowser.astro';
import { term } from '../../lib/terms';
export function getStaticPaths(){return gameClasses.map(cls=>({params:{slug:cls.slug},props:{cls}}));}
const {cls}=Astro.props;
const base=import.meta.env.BASE_URL;
const linked=skills.filter(skill=>skill.classId===cls.id);
const board=tree.classes[cls.code] as any;
---
<BaseLayout title={cls.name}>
<a class="back-link" href={`${base}classes/`}>← Sınıflara dön</a>
<section class="page-heading"><p class="eyebrow">{cls.name}</p><h1>{term(cls.code)}</h1><p>{linked.filter(s=>!s.parentId).length} ana yetenek ve {linked.filter(s=>s.parentId).length} geliştirme. {board?.nodes.length??0} kaynak düğümü ve {board?.edges.length??0} bağlantı.</p><a class="button secondary" href={`${base}skill-tree/#${cls.code}`}>Yetenek ağacını aç</a></section>
<form class="toolbar" role="search"><label class="field search-field">Bu sınıfta ara<input class="search" type="search" data-search placeholder="Yetenek veya geliştirme…"/></label><label class="field">Tür<select class="select" data-filter="type"><option value="">Tüm kayıtlar</option><option value="active">Aktif</option><option value="passive">Pasif</option><option value="modifier">Geliştirme</option></select></label></form>
<DataBrowser count={linked.length}><div class="card-grid" data-list tabindex="-1">{linked.map(skill=><a class="data-card" data-entry data-type={skill.type} data-searchtext={`${skill.name} ${skill.description??''}`} href={`${base}skills/${skill.slug}/`}><div class="card-main">{skill.icon&&<img class="entity-icon" src={`${base}${skill.icon}`} width="55" height="55" alt="" loading="lazy"/>}<div class="card-copy"><p class="card-kicker">{term(skill.type)} · {term(skill.category)}</p><h2>{skill.name}</h2></div></div><p>{skill.description??'Kaynak açıklaması bulunmuyor.'}</p></a>)}</div></DataBrowser>
<SourceDetails source={cls.source} patch={cls.patch}/>
</BaseLayout>
