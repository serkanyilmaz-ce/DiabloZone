---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SourceDetails from '../../components/SourceDetails.astro';
import { gameClasses,skills,tree } from '../../lib/data';
import DataBrowser from '../../components/DataBrowser.astro';
import { term } from '../../lib/terms';
import CatalogueCardView from '../../components/CatalogueCardView.astro';
import {catalogueCards} from '../../lib/catalogue-cards';
export function getStaticPaths(){return gameClasses.map(cls=>({params:{slug:cls.slug},props:{cls}}));}
const {cls}=Astro.props;
const base=import.meta.env.BASE_URL;
const linked=skills.filter(skill=>skill.classId===cls.id);
const board=tree.classes[cls.code] as any;
const linkedIds=new Set(linked.map(skill=>skill.id));
const cards=catalogueCards('skills').filter(card=>linkedIds.has(card.id));
---
<BaseLayout title={cls.name}>
<a class="back-link" href={`${base}classes/`}>← Sınıflara dön</a>
<section class="page-heading"><p class="eyebrow">{cls.name}</p><h1>{term(cls.code)}</h1><p>{linked.filter(s=>!s.parentId).length} ana yetenek ve {linked.filter(s=>s.parentId).length} geliştirme. {board?.nodes.length??0} kaynak düğümü ve {board?.edges.length??0} bağlantı.</p></section><p><a class="button secondary" href={`${base}skill-tree/#${cls.code}`}>Yetenek ağacını aç</a></p>
<form class="toolbar" role="search"><label class="field search-field"><span>Bu sınıfta ara</span><input class="search" type="search" data-search placeholder="Yetenek veya geliştirme…"/></label><label class="field"><span>Tür</span><select class="select" data-filter="type"><option value="">Tüm kayıtlar</option><option value="active">Aktif</option><option value="passive">Pasif</option><option value="modifier">Geliştirme</option></select></label></form>
<DataBrowser count={cards.length}><div class="card-grid" data-list tabindex="-1">{cards.map(card=><CatalogueCardView card={card} searchable/>)}</div></DataBrowser>
<SourceDetails source={cls.source} patch={cls.patch}/>
</BaseLayout>
