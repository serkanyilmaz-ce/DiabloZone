---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { skills, items, aspects, metadata } from '../lib/data';
const base = import.meta.env.BASE_URL;
const features = [
  {label:'Yetenekler', href:'skills/', note:'Sınıfının gücünü tanı. Aktif yetenekleri, pasifleri ve geliştirmeleri incele.', icon:'skills',count:skills.length,number:'01'},
  {label:'Eşyalar', href:'items/', note:'Doğru parçanın peşine düş. Eşya özelliklerini ve güçlerini karşılaştır.', icon:'items',count:items.length,number:'02'},
  {label:'Aspektler', href:'aspects/', note:'Build’ini değiştiren gücü bul. Efsanevi etkileri ve koşullarını keşfet.', icon:'aspects',count:aspects.length,number:'03'},
];
---
<BaseLayout title="Diablo IV veri & mekanik arşivi">
  <section class="home-hero" aria-labelledby="hero-title">
    <img class="hero-art" src={`${base}assets/ui/sanctuary-research.png`} alt="" width="1536" height="1024" fetchpriority="high" />
    <div class="hero-shade" aria-hidden="true"></div>
    <div class="hero-copy"><p class="eyebrow"><span class="red-line"></span> DIABLO IV · BAĞIMSIZ VERİ ARŞİVİ</p><h1 id="hero-title">Karanlığın ardındaki<br /><em>bilgiyi keşfet.</em></h1><p class="hero-lead">Yetenekler, eşyalar ve gizli çarpanlar.<br />Sanctuary’yi şansa bırakma. Mekaniklerini anla.</p>
      <form class="hero-search" action={`${base}search/`} role="search"><Icon name="search" /><label class="sr-only" for="hero-query">Veritabanında ara</label><input id="hero-query" name="q" type="search" placeholder="Yetenek, eşya veya aspekt ara…" /><button type="submit" aria-label="Ara"><Icon /></button><kbd aria-hidden="true">/</kbd></form>
      <div class="hero-actions"><a class="button primary" href="#arsiv">Arşivi keşfet <Icon size={17} /></a><a class="hero-secondary" href={`${base}skill-tree/`}><Icon name="tree" size={18} /> Yetenek ağacı</a></div>
    </div>
    <div class="hero-caption"><span class="status-dot"></span> SEZON 15 ARAŞTIRMASI <span>·</span> KAYNAKLI BİLGİ</div>
  </section>
  <section class="archive-section" id="arsiv" aria-labelledby="archive-title">
    <div class="section-heading"><div><p class="eyebrow">SANCTUARY ARŞİVİ</p><h2 id="archive-title">Bilgiyi güce dönüştür.</h2></div><span class="section-note">{metadata.gameBuild ? `İçe aktarılan build ${metadata.gameBuild}` : 'Oyun verisi içe aktarımı bekleniyor'}</span></div>
    <div class="home-feature-grid">{features.map(feature => <a class="feature-card" href={`${base}${feature.href}`}><div class="feature-top"><span class={`feature-icon icon-${feature.icon}`}><Icon name={feature.icon} size={29} /></span><span class="feature-number">{feature.number}</span></div><h3>{feature.label}</h3><p>{feature.note}</p><div class="feature-bottom"><span>{feature.count ? `${feature.count.toLocaleString('tr')} kayıt` : 'Veri bekleniyor'}</span><Icon size={20} /></div></a>)}</div>
  </section>
  <section class="research-banner" aria-labelledby="research-title"><div class="research-art" aria-hidden="true"><span class="research-glyph">∑</span><span class="orbit orbit-one"></span><span class="orbit orbit-two"></span><span class="formula-fragment">[+] &nbsp; × &nbsp; [x]</span></div><div class="research-copy"><p class="eyebrow">FORMÜL LABORATUVARI</p><h2 id="research-title">Tooltip’in ötesine bak.</h2><p>Toplamsal bonus mu, bağımsız çarpan mı? Hasardan RNG’ye, oyunun matematiğini kaynakları ve sınırlarıyla incele.</p><a class="text-link" href={`${base}lab/`}>Hasar & olasılık modellerini aç <Icon size={18} /></a></div><span class="research-tag">DENEYSEL MODELLER</span></section>
  <section class="principles" aria-label="Araştırma ilkeleri"><div><Icon name="book" /><p><strong>Kaynağı belli</strong><span>Her bilgi, bir dayanağa bağlı.</span></p></div><div><Icon name="formula" /><p><strong>Matematiği açık</strong><span>Varsayım ve kanıt ayrı görünür.</span></p></div><div><Icon name="shield" /><p><strong>Sürümü kayıtlı</strong><span>PTR ve canlı veri birbirine karışmaz.</span></p></div></section>
</BaseLayout>
