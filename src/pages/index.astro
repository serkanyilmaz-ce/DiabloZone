---
import BaseLayout from '../layouts/BaseLayout.astro';
import metadata from '../../data/generated/metadata.json';
import skills from '../../data/generated/skills.json';
import items from '../../data/generated/items.json';
import aspects from '../../data/generated/aspects.json';
import affixes from '../../data/generated/affixes.json';
const base = import.meta.env.BASE_URL;
const cards = [
  {label:'Skills', count:skills.length, href:`${base}skills/`, note:'Learnable active and passive skills'},
  {label:'Items', count:items.length, href:`${base}items/`, note:'Canonical Unique & Mythic equipment'},
  {label:'Aspects', count:aspects.length, href:`${base}aspects/`, note:'Legendary aspect definitions'},
  {label:'Affixes', count:affixes.length, href:null, note:'Resolved item/aspect affix records'},
];
---
<BaseLayout title="Game Data">
  <section class="hero">
    <p class="eyebrow">Unofficial Diablo IV database</p>
    <h1>DiabloZone</h1>
    <p>Fast, static game-data browser built from normalized DiabloTools/d4data records.</p>
    <div class="hero-meta"><span>Build {metadata.gameBuild}</span><span>No backend</span><span>Static Astro</span></div>
  </section>
  <section class="stats-grid">
    {cards.map((card)=><article class="stat-card"><span>{card.label}</span><strong>{card.count}</strong><p>{card.note}</p>{card.href && <a href={card.href}>Browse →</a>}</article>)}
  </section>
  <section class="home-section">
    <div><p class="eyebrow">M1</p><h2>Browse the canonical data</h2><p>Search and filter the current imported build. Detail pages preserve source SNO references and raw tooltip templates for traceability.</p></div>
    <div class="quick-links"><a href={`${base}skills/`}>Explore skills</a><a href={`${base}items/`}>Explore items</a><a href={`${base}aspects/`}>Explore aspects</a></div>
  </section>
</BaseLayout>
