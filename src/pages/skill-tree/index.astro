---
import BaseLayout from '../../layouts/BaseLayout.astro';
import tree from '../../../data/generated/skill-tree.json';
import skills from '../../../data/generated/skills.json';
const base=import.meta.env.BASE_URL;
const skillBySno=new Map(skills.map((s:any)=>[Number(s.source?.sno),s]));
const classes=Object.keys((tree as any).classes??{});
const panels=classes.map((cls)=>{
  const nodes=((tree as any).classes[cls]??[]).map((node:any)=>({...node,skill:skillBySno.get(Number(node.powerSno))}));
  const groups=new Map<string,any[]>();
  for(const node of nodes){const key=node.category||'uncategorized';if(!groups.has(key))groups.set(key,[]);groups.get(key)!.push(node);}
  return {cls,groups:[...groups.entries()]};
});
---
<BaseLayout title="Skill Tree" description="Current Diablo IV logical skill tree built from DiabloTools/d4data SkillTreeRewards">
  <section class="hero compact">
    <p class="eyebrow">Current game skill branches</p>
    <h1>Skill Tree</h1>
    <p>Current imported build skill unlocks and upgrade branches, resolved from the game data.</p>
  </section>

  <div class="tree-tabs" role="tablist" aria-label="Class skill trees">
    {panels.map((panel,index)=><button type="button" class:list={{active:index===0}} data-tree-tab={panel.cls}>{panel.cls}</button>)}
  </div>
  <p class="tree-note">Logical unlock and modifier relationships come from <code>SkillTreeRewards</code>. Node placement is DiabloZone-generated until the game client’s exact board coordinates and edge geometry are decoded.</p>

  {panels.map((panel,index)=><section class="tree-board" data-tree-panel={panel.cls} hidden={index!==0}>
    {panel.groups.map(([category,nodes])=><section class="tree-tier">
      <h2>{category}</h2>
      <div class="tree-tier-track">
        <div class="tree-tier-nodes">
          {nodes.map((node:any)=><article class="tree-branch">
            <a class="tree-node tree-node-main" href={`${base}skills/${node.skillSlug}/`}>
              {node.skill?.icon ? <img src={`${base}${node.skill.icon}`} alt="" loading="lazy" /> : <span class="tree-node-glyph">✦</span>}
              <span class="tree-node-name">{node.name}</span>
              {node.maxRanks && <small>{node.maxRanks} ranks</small>}
            </a>
            {(node.modifiers?.length??0)>0 && <div class="tree-modifiers">
              {node.modifiers.map((mod:any)=><div class:list={['tree-mod',{'tree-mod-defining':mod.defining}]} title={mod.rewardName??mod.label}>
                <span class="tree-mod-dot"></span><span>{mod.label}</span>{mod.maxRanks && <small>{mod.maxRanks}</small>}
              </div>)}
            </div>}
          </article>)}
        </div>
      </div>
    </section>)}
  </section>)}

  <script is:inline>
    (()=>{
      const tabs=[...document.querySelectorAll('[data-tree-tab]')];
      const panels=[...document.querySelectorAll('[data-tree-panel]')];
      const select=(cls)=>{tabs.forEach(x=>x.classList.toggle('active',x.dataset.treeTab===cls));panels.forEach(x=>x.hidden=x.dataset.treePanel!==cls);};
      tabs.forEach(tab=>tab.addEventListener('click',()=>select(tab.dataset.treeTab)));
    })();
  </script>
  <style>
    .tree-tabs{display:flex;flex-wrap:wrap;gap:8px;margin:10px 0 14px;padding:10px;border:1px solid var(--line);background:color-mix(in srgb,var(--surface) 82%,transparent)}
    .tree-tabs button{appearance:none;border:1px solid var(--line);background:var(--input-bg);color:var(--muted);padding:10px 14px;text-transform:uppercase;letter-spacing:.08em;font-size:.72rem;cursor:pointer;transition:.16s}
    .tree-tabs button:hover,.tree-tabs button.active{border-color:var(--blood-2);color:var(--text-strong);background:linear-gradient(180deg,color-mix(in srgb,var(--blood) 24%,var(--surface-2)),var(--surface));box-shadow:0 0 18px color-mix(in srgb,var(--blood) 20%,transparent)}
    .tree-note{color:var(--muted);font-size:.78rem;line-height:1.6;margin:0 0 28px}.tree-note code{color:var(--gold-soft)}
    .tree-board{display:grid;gap:34px;position:relative;padding:28px 18px 48px;border:1px solid var(--line);background:radial-gradient(circle at 50% 0,color-mix(in srgb,var(--blood) 12%,transparent),transparent 32%),linear-gradient(180deg,color-mix(in srgb,var(--surface) 86%,transparent),color-mix(in srgb,var(--bg) 96%,transparent));box-shadow:inset 0 0 80px rgba(0,0,0,.18)}
    .tree-tier{position:relative}.tree-tier:not(:last-child):after{content:"";position:absolute;left:50%;bottom:-34px;width:1px;height:34px;background:linear-gradient(var(--gold),var(--blood-2));opacity:.5}
    .tree-tier h2{margin:0 0 18px;text-align:center;text-transform:uppercase;letter-spacing:.16em;color:var(--gold-soft);font-size:.95rem}
    .tree-tier-track{overflow-x:auto;padding:8px 4px 14px}.tree-tier-nodes{display:flex;align-items:flex-start;justify-content:center;gap:30px;min-width:max-content}
    .tree-branch{width:180px;display:grid;justify-items:center;position:relative}.tree-branch:before{content:"";position:absolute;top:37px;left:-30px;width:30px;height:1px;background:var(--line-strong);opacity:.42}.tree-branch:first-child:before{display:none}
    .tree-node-main{display:grid;justify-items:center;gap:8px;width:112px;text-align:center;color:var(--text-strong)}
    .tree-node-main img,.tree-node-glyph{width:68px;height:68px;border-radius:50%;object-fit:cover;border:2px solid var(--gold);background:radial-gradient(circle,var(--surface-3),var(--bg));box-shadow:0 0 0 4px var(--icon-ring),0 0 25px color-mix(in srgb,var(--blood) 30%,transparent)}
    .tree-node-glyph{display:grid;place-items:center;color:var(--gold-soft);font-size:1.5rem}.tree-node-name{font-size:.78rem;line-height:1.25}.tree-node-main small{font-family:var(--font-ui);color:var(--muted-2);font-size:.64rem}
    .tree-modifiers{display:grid;gap:8px;margin-top:18px;width:100%;position:relative}.tree-modifiers:before{content:"";position:absolute;left:15px;top:-18px;height:18px;width:1px;background:var(--line-strong)}
    .tree-mod{display:grid;grid-template-columns:22px 1fr auto;gap:7px;align-items:center;border:1px solid var(--line);background:var(--input-bg);padding:7px 8px;color:var(--muted);font-size:.68rem;line-height:1.25}.tree-mod-dot{width:18px;height:18px;border-radius:50%;border:1px solid var(--gold);background:radial-gradient(circle,var(--surface-3),var(--bg));box-shadow:0 0 0 2px var(--icon-ring)}.tree-mod-defining .tree-mod-dot{border-color:var(--ember);box-shadow:0 0 10px color-mix(in srgb,var(--ember) 30%,transparent)}.tree-mod small{color:var(--gold-soft)}
    @media(max-width:720px){.tree-board{padding-inline:8px}.tree-tier-nodes{justify-content:flex-start}.tree-tabs{overflow-x:auto;flex-wrap:nowrap}.tree-tabs button{white-space:nowrap}}
  </style>
</BaseLayout>
