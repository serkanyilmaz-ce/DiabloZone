---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArchiveList from '../../components/ArchiveList.astro';
import {skills} from '../../lib/data';
import { term } from '../../lib/terms';
const base = import.meta.env.BASE_URL;
const classes = [...new Set(skills.map(skill => skill.class))].sort();
---
<BaseLayout title="Yetenekler">
  <div class="breadcrumbs"><a href={base}>Ana sayfa</a><span>/</span><span>Veritabanı</span><span>/</span><span>Yetenekler</span></div>
  <section class="page-heading"><p class="eyebrow">GÜCÜNÜN TEMELİ</p><h1>Yetenekler</h1><p>Aktif yetenekler, pasif etkiler ve geliştirmeler. Sınıfını seç, bir sonraki build’inin temelini keşfet.</p></section>
  <form class="toolbar" role="search"><label class="field search-field">Arama<input class="search" type="search" placeholder="Yetenek adı, açıklama veya etiket…" data-search /></label><label class="field">Sınıf<select class="select" data-filter="class"><option value="">Tüm sınıflar</option>{classes.map(cls => <option value={cls}>{term(cls)}</option>)}</select></label><label class="field">Tür<select class="select" data-filter="type"><option value="">Tüm kayıtlar</option><option value="active">Aktif</option><option value="passive">Pasif</option><option value="modifier">Geliştirme</option></select></label></form>
  <ArchiveList kind="skills" />
</BaseLayout>
