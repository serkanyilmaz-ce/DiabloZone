{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "build/service",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["node"]
  },
  "include": ["scripts/service.ts", "scripts/db/**/*.ts", "src/lib/api-query.ts", "src/lib/client-address.ts", "src/lib/tooltip.ts", "schemas/domain.ts"]
}
